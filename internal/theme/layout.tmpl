{{ define "VPNav" }}
<header class="VPNav">
	<div class="VPNavBar">
		<div class="title">
			<a href="{{ .SiteConfig.Base }}">
				{{ if .SiteConfig.ThemeConfig.Logo.Light }}<img src="{{ .SiteConfig.ThemeConfig.Logo.Light }}" alt="{{ .SiteConfig.ThemeConfig.Logo.Alt }}" class="logo light-only">{{ end }}
				{{ if .SiteConfig.ThemeConfig.Logo.Dark }}<img src="{{ .SiteConfig.ThemeConfig.Logo.Dark }}" alt="{{ .SiteConfig.ThemeConfig.Logo.Alt }}" class="logo dark-only">{{ end }}
				{{ .SiteConfig.Title }}
			</a>
		</div>
		<div class="content">
			<nav class="VPNavBarMenu">
				{{ range .SiteConfig.ThemeConfig.Nav }}
				<a class="VPLink" href="{{ .Link }}">{{ .Text }}</a>
				{{ end }}
			</nav>
			<div class="VPNavBarAppearance">
				<button class="VPSwitchAppearance" type="button" aria-label="Toggle dark mode" onclick="toggleDarkMode()">
					<span class="vpi-sun sun">☀️</span>
					<span class="vpi-moon moon">🌙</span>
				</button>
			</div>
			<div class="VPNavBarSocialLinks">
				{{ range .SiteConfig.ThemeConfig.SocialLinks }}
				<a class="VPSocialLink" href="{{ .Link }}" target="_blank" rel="noopener" aria-label="{{ .Icon }}">
					<span class="vpi-social vpi-social-{{ .Icon }}">{{ .Icon }}</span>
				</a>
				{{ end }}
			</div>
			{{ if not .IsHome }}
			<button class="VPNavBarHamburger" type="button" aria-label="mobile navigation" onclick="toggleSidebar()">☰</button>
			{{ end }}
		</div>
	</div>
</header>
{{ end }}

{{ define "VPSidebarItemNode" }}
<div class="VPSidebarItem {{ if .IsCollapsible }}is-collapsible{{ end }} {{ if .IsCollapsed }}collapsed{{ end }}">
	<div class="item-row">
		{{ if .Link }}
		<a class="VPLink link" href="{{ .Link }}"><span class="text">{{ .Text }}</span></a>
		{{ else }}
		<span class="text">{{ .Text }}</span>
		{{ end }}
		{{ if .IsCollapsible }}
		<div class="caret" onclick="toggleSidebarGroup(this)">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="vpi-chevron-right"><polyline points="9 18 15 12 9 6"></polyline></svg>
		</div>
		{{ end }}
	</div>
	{{ if .Items }}
	<div class="VPSidebarGroup" {{ if .IsCollapsed }}style="display: none;"{{ end }}>
		{{ range .Items }}
		{{ template "VPSidebarItemNode" . }}
		{{ end }}
	</div>
	{{ end }}
</div>
{{ end }}

{{ define "VPSidebar" }}
{{ if .HasSidebar }}
<aside class="VPSidebar" id="VPSidebar">
	<nav class="nav" id="VPSidebarNav">
		{{ range .SidebarData }}
		<div class="VPSidebarGroup">
			{{ template "VPSidebarItemNode" . }}
		</div>
		{{ end }}
	</nav>
</aside>
{{ end }}
{{ end }}

{{ define "VPContent" }}
<div class="VPContent {{ if .IsHome }}is-home{{ end }}" id="VPContent">
	{{ if .IsHome }}
		{{ template "VPHome" . }}
	{{ else }}
		{{ template "VPDoc" . }}
	{{ end }}
</div>
{{ end }}

{{ define "VPHome" }}
<div class="VPHome">
	{{ if .Hero.Name }}
	<div class="VPHero">
		<div class="container">
			<div class="main">
				<h1 class="name">{{ .Hero.Name }}</h1>
				{{ if .Hero.Text }}<p class="text">{{ .Hero.Text }}</p>{{ end }}
				{{ if .Hero.Tagline }}<p class="tagline">{{ .Hero.Tagline }}</p>{{ end }}
				{{ if .Hero.Actions }}
				<div class="actions">
					{{ range .Hero.Actions }}
					<div class="action">
						<a class="VPButton {{ .Theme }}" href="{{ .Link }}">{{ .Text }}</a>
					</div>
					{{ end }}
				</div>
				{{ end }}
			</div>
		</div>
	</div>
	{{ end }}
	{{ if .Features }}
	<div class="VPFeatures">
		<div class="container">
			<div class="items">
				{{ range .Features }}
				<div class="item">
					<div class="VPFeature">
						<h2 class="title">{{ .Title }}</h2>
						{{ if .Details }}<p class="details">{{ .Details }}</p>{{ end }}
					</div>
				</div>
				{{ end }}
			</div>
		</div>
	</div>
	{{ end }}
	<div class="main">
		{{ .Content }}
	</div>
</div>
{{ end }}

{{ define "VPDoc" }}
<div class="VPDoc">
	<div class="container">
		<div class="content">
			<main class="main" id="main-content">
				{{ .Content }}
			</main>
		</div>
	</div>
</div>
{{ end }}

{{ define "VPFooter" }}
{{ if .SiteConfig.ThemeConfig.Footer }}
<footer class="VPFooter {{ if .IsHome }}is-home{{ end }}">
	<div class="container">
		{{ if .SiteConfig.ThemeConfig.Footer.message }}<p class="message">{{ .SiteConfig.ThemeConfig.Footer.message }}</p>{{ end }}
		{{ if .SiteConfig.ThemeConfig.Footer.copyright }}<p class="copyright">{{ .SiteConfig.ThemeConfig.Footer.copyright }}</p>{{ end }}
	</div>
</footer>
{{ end }}
{{ end }}

<!DOCTYPE html>
<html lang="{{ .SiteConfig.Lang }}">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{{ if .PageTitle }}{{ .PageTitle }} | {{ end }}{{ .SiteConfig.Title }}</title>
	<meta name="description" content="{{ .SiteConfig.Description }}">
	<link rel="stylesheet" href="{{ .SiteConfig.Base }}assets/theme.css">
	<script>
		const savedTheme = localStorage.getItem('gopress-theme-appearance');
		const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
		if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
			document.documentElement.classList.add('dark');
		}

		// 提前恢复侧边栏折叠状态，在DOM解析期间立即应用，彻底避免页面渲染闪烁
		(function() {
			try {
				const saved = localStorage.getItem('gopress-sidebar-states');
				if (!saved) return;
				const states = JSON.parse(saved);
				
				const observer = new MutationObserver((mutations) => {
					for (const mutation of mutations) {
						for (const node of mutation.addedNodes) {
							if (node.nodeType !== 1) continue;
							
							const items = node.classList && node.classList.contains('VPSidebarItem') 
								? [node] 
								: node.querySelectorAll ? Array.from(node.querySelectorAll('.VPSidebarItem.is-collapsible')) : [];
							
							for (const item of items) {
								if (!item.classList || !item.classList.contains('is-collapsible')) continue;
								const textEl = item.querySelector('.item-row > .text');
								const key = textEl ? textEl.textContent.trim() : '';
								
								if (key && states[key] !== undefined) {
									let group = null;
									for (let i = 0; i < item.children.length; i++) {
										if (item.children[i].classList.contains('VPSidebarGroup')) {
											group = item.children[i];
											break;
										}
									}
									if (states[key]) {
										item.classList.add('collapsed');
										if (group) group.style.display = 'none';
									} else {
										item.classList.remove('collapsed');
										if (group) group.style.display = '';
									}
								}
							}
						}
					}
				});
				observer.observe(document.documentElement, { childList: true, subtree: true });
				document.addEventListener('DOMContentLoaded', () => observer.disconnect());
			} catch (e) {}
		})();
	</script>
</head>
<body>
	<div class="Layout" id="Layout">
		{{ template "VPNav" . }}
		{{ template "VPSidebar" . }}
		{{ template "VPContent" . }}
		{{ template "VPFooter" . }}
	</div>
	<script type="module" src="{{ .SiteConfig.Base }}assets/app.js"></script>
</body>
</html>